@inherits LayoutComponentBase

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="@ToggleDrawer" />
        <MudText Typo="Typo.h6" Class="ml-3">EduTeacher</MudText>
        <MudSpacer />
        <MudIconButton Icon="@Icons.Material.Filled.Notifications" Color="Color.Inherit" Href="/settings" />
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2">
        <MudNavMenu>
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">Dashboard</MudNavLink>
            <MudNavLink Href="/schedule" Icon="@Icons.Material.Filled.Schedule">Schedule</MudNavLink>
            <MudNavGroup Title="Attendance" Icon="@Icons.Material.Filled.FactCheck" Expanded="false">
                <MudNavLink Href="/attendance/mark">Mark Attendance</MudNavLink>
                <MudNavLink Href="/attendance/history">History</MudNavLink>
            </MudNavGroup>
            <MudNavLink Href="/assessments" Icon="@Icons.Material.Filled.Assignment">Assessments</MudNavLink>
            <MudNavLink Href="/grades" Icon="@Icons.Material.Filled.Grade">Grades</MudNavLink>
            <MudNavGroup Title="Payroll" Icon="@Icons.Material.Filled.Payments" Expanded="false">
                <MudNavLink Href="/payroll">Overview</MudNavLink>
                <MudNavLink Href="/payroll/payslips">Payslips</MudNavLink>
                <MudNavLink Href="/payroll/tax">Tax Declaration</MudNavLink>
                <MudNavLink Href="/payroll/reimbursement">Reimbursement</MudNavLink>
            </MudNavGroup>
            <MudNavLink Href="/announcements" Icon="@Icons.Material.Filled.Campaign">Announcements</MudNavLink>
            <MudNavLink Href="/chat" Icon="@Icons.Material.Filled.Chat">Chat</MudNavLink>
            <MudNavLink Href="/settings" Icon="@Icons.Material.Filled.Settings">Settings</MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent Class="pa-4">
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }
}
