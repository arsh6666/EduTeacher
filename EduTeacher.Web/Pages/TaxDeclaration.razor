@page "/payroll/tax"
@inherits RootflyComponentBase<TaxDeclarationViewModel>

<MudText Typo="Typo.h4" Class="mb-2">Tax Declaration</MudText>
<MudText Typo="Typo.subtitle1" Color="Color.Secondary" Class="mb-4">FY @ViewModel.CurrentDeclaration?.FiscalYear</MudText>

@if (ViewModel.IsBusy)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    @if (ViewModel.CurrentDeclaration is not null)
    {
        <MudGrid Class="mb-4">
            <MudItem xs="12" sm="4">
                <MudCard>
                    <MudCardContent>
                        <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Regime</MudText>
                        <MudText Typo="Typo.h6">@ViewModel.CurrentDeclaration.RegimeType</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudCard>
                    <MudCardContent>
                        <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Status</MudText>
                        <MudText Typo="Typo.h6">@ViewModel.CurrentDeclaration.Status</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudCard>
                    <MudCardContent>
                        <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Total Declared</MudText>
                        <MudText Typo="Typo.h6">@ViewModel.CurrentDeclaration.TotalDeclaredAmount.ToString("C")</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>
    }

    <MudTable Items="ViewModel.CurrentDeclaration?.Lines" Hover="true" Elevation="2">
        <HeaderContent>
            <MudTh>Section</MudTh>
            <MudTh>Description</MudTh>
            <MudTh>Declared</MudTh>
            <MudTh>Approved</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.TaxExemptionCategoryId</MudTd>
            <MudTd>@context.Remarks</MudTd>
            <MudTd>@context.DeclaredAmount.ToString("C")</MudTd>
            <MudTd>@context.ApprovedAmount?.ToString("C")</MudTd>
        </RowTemplate>
    </MudTable>

    @if (ViewModel.CurrentDeclaration?.Status != TaxDeclarationStatus.Locked)
    {
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4"
                   OnClick="@(async () => await ViewModel.SubmitDeclarationCommand.ExecuteAsync(null))">
            Submit Declaration
        </MudButton>
    }
}
