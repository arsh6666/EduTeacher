@page "/payroll/reimbursement"
@inherits RootflyComponentBase<ReimbursementViewModel>

<MudText Typo="Typo.h4" Class="mb-4">Reimbursements</MudText>

@if (ViewModel.IsBusy)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudCard Class="mb-4">
        <MudCardContent>
            <MudText Typo="Typo.h6" Class="mb-2">New Claim</MudText>
            <MudGrid>
                <MudItem xs="12" sm="4">
                    <MudTextField @bind-Value="ViewModel.ClaimType" Label="Type" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudNumericField @bind-Value="ViewModel.ClaimAmount" Label="Amount" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField @bind-Value="ViewModel.ClaimDescription" Label="Description" Variant="Variant.Outlined" />
                </MudItem>
            </MudGrid>
        </MudCardContent>
        <MudCardActions>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       Disabled="ViewModel.IsSubmitting"
                       OnClick="@(() => ViewModel.SubmitClaimCommand.Execute(null))">
                @if (ViewModel.IsSubmitting)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                Submit Claim
            </MudButton>
        </MudCardActions>
    </MudCard>

    <MudText Typo="Typo.h6" Class="mb-2">Past Claims</MudText>
    <MudTable Items="ViewModel.Claims" Hover="true" Elevation="2">
        <HeaderContent>
            <MudTh>Type</MudTh>
            <MudTh>Amount</MudTh>
            <MudTh>Description</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Date</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Type</MudTd>
            <MudTd>@context.Amount.ToString("C")</MudTd>
            <MudTd>@context.Description</MudTd>
            <MudTd>
                <MudChip T="string" Size="Size.Small"
                         Color="@(context.Status == "Approved" ? Color.Success : context.Status == "Rejected" ? Color.Error : Color.Warning)">
                    @context.Status
                </MudChip>
            </MudTd>
            <MudTd>@context.RequestDate.ToString("MMM dd, yyyy")</MudTd>
        </RowTemplate>
    </MudTable>
}
