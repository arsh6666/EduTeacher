@page "/payroll/payslips"
@inherits RootflyComponentBase<PayslipListViewModel>

<MudText Typo="Typo.h4" Class="mb-4">Payslips</MudText>

@if (ViewModel.IsBusy)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudTable Items="ViewModel.Payslips" Hover="true" Elevation="2">
        <HeaderContent>
            <MudTh>Period</MudTh>
            <MudTh>Gross Pay</MudTh>
            <MudTh>Total Deductions</MudTh>
            <MudTh>Net Pay</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Pay Date</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.StartDate.ToString("MMM yyyy")</MudTd>
            <MudTd>@context.GrossPay.ToString("C")</MudTd>
            <MudTd>@context.TotalDeductions.ToString("C")</MudTd>
            <MudTd>@context.NetPay.ToString("C")</MudTd>
            <MudTd>
                <MudChip T="string" Size="Size.Small"
                         Color="@(context.Status == SalarySlipStatus.Paid ? Color.Success : Color.Warning)">
                    @context.Status
                </MudChip>
            </MudTd>
            <MudTd>@context.PayDate.ToString("MMM dd, yyyy")</MudTd>
            <MudTd>
                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                           OnClick="@(() => ViewModel.ViewPayslipCommand.Execute(context.Id))">
                    View
                </MudButton>
            </MudTd>
        </RowTemplate>
    </MudTable>
}
