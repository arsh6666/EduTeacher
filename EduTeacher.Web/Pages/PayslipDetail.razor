@page "/payroll/payslips/{Id:guid}"
@inherits RootflyComponentBase<PayslipDetailViewModel>

<MudText Typo="Typo.h4" Class="mb-2">Payslip Detail</MudText>
<MudText Typo="Typo.subtitle1" Color="Color.Secondary" Class="mb-4">@ViewModel.PeriodLabel</MudText>

@if (ViewModel.IsBusy)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudGrid>
        <MudItem xs="12" md="6">
            <MudText Typo="Typo.h6" Class="mb-2">Earnings</MudText>
            <MudTable Items="ViewModel.Earnings" Hover="true" Elevation="1" Dense="true">
                <HeaderContent>
                    <MudTh>Component</MudTh>
                    <MudTh>Amount</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.ComponentName</MudTd>
                    <MudTd>@context.Amount.ToString("C")</MudTd>
                </RowTemplate>
            </MudTable>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudText Typo="Typo.h6" Class="mb-2">Deductions</MudText>
            <MudTable Items="ViewModel.Deductions" Hover="true" Elevation="1" Dense="true">
                <HeaderContent>
                    <MudTh>Component</MudTh>
                    <MudTh>Amount</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.ComponentName</MudTd>
                    <MudTd>@context.Amount.ToString("C")</MudTd>
                </RowTemplate>
            </MudTable>
        </MudItem>
    </MudGrid>

    <MudCard Class="mt-4">
        <MudCardContent>
            <MudText Typo="Typo.h6">Net Pay: @ViewModel.Payslip?.NetPay.ToString("C")</MudText>
        </MudCardContent>
    </MudCard>
}

@code {
    [Parameter] public Guid Id { get; set; }
}
