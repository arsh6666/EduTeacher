<?xml version="1.0" encoding="utf-8" ?>
<core:BaseContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                       xmlns:core="clr-namespace:Rootfly.Mobile.Core.UI.Pages;assembly=Rootfly.Mobile.Core.UI"
                       xmlns:vm="clr-namespace:EduTeacher.Shared.ViewModels;assembly=EduTeacher.Shared"
                       x:Class="EduTeacher.Views.LargeScreen.ProfileLargeScreenPage"
                       x:TypeArguments="vm:PlaceholderViewModel"
                       Shell.NavBarIsVisible="True"
                       Title="{{Binding Title}}">
    <Grid ColumnDefinitions="360,*" ColumnSpacing="0">
        <Border Grid.Column="0" StrokeThickness="0" BackgroundColor="White">
            <ScrollView>
                <VerticalStackLayout Spacing="16" Padding="24">
                    <Label Text="{{Binding Title}}"
                           FontSize="22" FontAttributes="Bold"
                           TextColor="{{StaticResource Primary}}"
                           FontFamily="Poppins" />
                    <ActivityIndicator IsRunning="{{Binding IsBusy}}"
                                       Color="{{StaticResource Primary}}"
                                       IsVisible="{{Binding IsBusy}}" />
                    <Label Text="Select an item to view details"
                           TextColor="#999" FontSize="14" />
                </VerticalStackLayout>
            </ScrollView>
        </Border>
        <ScrollView Grid.Column="1" BackgroundColor="#F5F5F5">
            <VerticalStackLayout Spacing="16" Padding="32">
                <Label Text="{{Binding Title}}"
                       FontSize="28" FontAttributes="Bold"
                       TextColor="{{StaticResource Primary}}"
                       FontFamily="Poppins" />
                <Label Text="Select an item from the left panel."
                       FontSize="16" TextColor="#666" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</core:BaseContentPage>
