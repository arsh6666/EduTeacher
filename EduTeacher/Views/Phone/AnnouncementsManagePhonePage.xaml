<?xml version="1.0" encoding="utf-8" ?>
<core:BaseContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                       xmlns:core="clr-namespace:Rootfly.Mobile.Core.UI.Pages;assembly=Rootfly.Mobile.Core.UI"
                       xmlns:vm="clr-namespace:EduTeacher.Shared.ViewModels;assembly=EduTeacher.Shared"
                       x:Class="EduTeacher.Views.Phone.AnnouncementsManagePhonePage"
                       x:TypeArguments="vm:AnnouncementManageViewModel"
                       Title="{Binding Title}">

    <Grid RowDefinitions="*,Auto">
        <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding RefreshCommand}">
            <ScrollView>
                <VerticalStackLayout Spacing="12" Padding="16">

                    <!-- Header -->
                    <Label Text="Announcements" FontSize="22" FontAttributes="Bold"
                           FontFamily="Poppins" TextColor="#1A73E8" />

                    <!-- Empty State -->
                    <Border IsVisible="{Binding IsEmpty}" StrokeShape="RoundRectangle 12"
                            BackgroundColor="#F5F5F5" Padding="32" Stroke="Transparent">
                        <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                            <Label Text="📢" FontSize="40" HorizontalOptions="Center" />
                            <Label Text="No announcements yet" FontSize="15" TextColor="#666"
                                   HorizontalOptions="Center" />
                            <Label Text="Tap + to create one" FontSize="13" TextColor="#888"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Announcements List -->
                    <CollectionView ItemsSource="{Binding Announcements}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border StrokeShape="RoundRectangle 12" Stroke="#E0E0E0"
                                        BackgroundColor="White" Padding="16" Margin="0,0,0,12"
                                        Shadow="{Shadow Opacity=0.08, Offset='0,2'}">
                                    <VerticalStackLayout Spacing="8">
                                        <!-- Title + Status -->
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Text="{Binding Title}" FontSize="16"
                                                   FontAttributes="Bold" FontFamily="Poppins" />
                                            <Border Grid.Column="1" StrokeShape="RoundRectangle 10"
                                                    Padding="8,4" Stroke="Transparent"
                                                    BackgroundColor="{Binding IsPublished, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#E8F5E9|#FFF3E0'}">
                                                <Label Text="{Binding IsPublished, Converter={StaticResource BoolToStringConverter}, ConverterParameter='Published|Draft'}"
                                                       FontSize="11"
                                                       TextColor="{Binding IsPublished, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#2E7D32|#E65100'}" />
                                            </Border>
                                        </Grid>

                                        <!-- Content preview -->
                                        <Label Text="{Binding Content}" FontSize="13" TextColor="#666"
                                               LineBreakMode="TailTruncation" MaxLines="2" />

                                        <!-- Audience + Date -->
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label FontSize="12" TextColor="#888">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="Audience: " />
                                                        <Span Text="{Binding Audience}" FontAttributes="Bold" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                            <Label Grid.Column="1" FontSize="12" TextColor="#888"
                                                   Text="{Binding CreationTime, StringFormat='{0:MMM dd}'}" />
                                        </Grid>

                                        <!-- Publish button for drafts -->
                                        <Button Text="Publish" BackgroundColor="#00897B" TextColor="White"
                                                CornerRadius="10" HeightRequest="36" FontSize="13"
                                                IsVisible="{Binding IsPublished, Converter={StaticResource InvertedBoolConverter}}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AnnouncementManageViewModel}}, Path=PublishCommand}"
                                                CommandParameter="{Binding .}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <!-- FAB -->
        <Button Grid.Row="1" Text="＋" FontSize="24" TextColor="White"
                BackgroundColor="#1A73E8" CornerRadius="28"
                WidthRequest="56" HeightRequest="56"
                Margin="0,0,20,20" HorizontalOptions="End"
                Shadow="{Shadow Opacity=0.2, Offset='0,4'}"
                Command="{Binding CreateNewCommand}" />
    </Grid>

</core:BaseContentPage>
