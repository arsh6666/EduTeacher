<?xml version="1.0" encoding="utf-8" ?>
<ui:BaseContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ui="clr-namespace:Rootfly.Mobile.Core.UI.Pages;assembly=Rootfly.Mobile.Core.UI"
    xmlns:vm="clr-namespace:EduTeacher.Shared.ViewModels;assembly=EduTeacher.Shared"
    xmlns:dtos="clr-namespace:EduTeacher.Shared.Education.Dtos;assembly=EduTeacher.Shared"
    x:Class="EduTeacher.Views.Phone.AssessmentListPhonePage"
    x:TypeArguments="vm:AssessmentListViewModel"
    Title="{Binding Title}">

    <Grid RowDefinitions="*,Auto">
        <RefreshView Grid.Row="0" Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsBusy}">
            <CollectionView ItemsSource="{Binding Assessments}" EmptyView="No assessments yet" Margin="16">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dtos:AssessmentDto">
                        <Frame Padding="14" CornerRadius="12" BorderColor="Transparent" HasShadow="True" Margin="0,0,0,10"
                               BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AssessmentListViewModel}}, Path=NavigateToSubmissionsCommand}"
                                                     CommandParameter="{Binding .}" />
                            </Frame.GestureRecognizers>
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                                <Label Grid.Row="0" Grid.Column="0" Text="{Binding Title}" FontSize="15" FontAttributes="Bold" />
                                <Frame Grid.Row="0" Grid.Column="1" Padding="6,3" CornerRadius="8" HasShadow="False"
                                       BackgroundColor="{StaticResource Primary}" BorderColor="Transparent">
                                    <Label Text="{Binding AssessmentType}" FontSize="10" TextColor="White" />
                                </Frame>
                                <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding CourseName}" FontSize="12" TextColor="Gray" />
                                <HorizontalStackLayout Grid.Row="2" Grid.ColumnSpan="2" Spacing="16">
                                    <Label FontSize="11" TextColor="Gray">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="Due: " />
                                                <Span Text="{Binding DueDate, StringFormat='{0:MMM dd}'}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <Label FontSize="11" TextColor="{StaticResource Secondary}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding GradedCount}" />
                                                <Span Text="/" />
                                                <Span Text="{Binding SubmissionCount}" />
                                                <Span Text=" graded" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </HorizontalStackLayout>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!-- FAB -->
        <Button Grid.Row="1" Text="+ New Assessment" Command="{Binding NavigateToCreateCommand}"
                BackgroundColor="{StaticResource Primary}" TextColor="White"
                CornerRadius="24" HeightRequest="50" FontSize="15" FontAttributes="Bold"
                Margin="16,0,16,16" />
    </Grid>
</ui:BaseContentPage>
