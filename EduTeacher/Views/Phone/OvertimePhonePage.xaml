<?xml version="1.0" encoding="utf-8" ?>
<ui:BaseContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ui="clr-namespace:Rootfly.Mobile.Core.UI.Pages;assembly=Rootfly.Mobile.Core.UI"
    xmlns:vm="clr-namespace:EduTeacher.Shared.ViewModels;assembly=EduTeacher.Shared"
    x:Class="EduTeacher.Views.Phone.OvertimePhonePage"
    x:TypeArguments="vm:OvertimeViewModel"
    Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Spacing="12" Padding="16">
            <!-- Header -->
            <Border StrokeShape="RoundRectangle 0,0,24,24" Stroke="Transparent"
                    BackgroundColor="{StaticResource Primary}" Padding="24,48,24,24">
                <Label Text="{Binding Title}" FontSize="24" FontAttributes="Bold" TextColor="White" />
            </Border>

            <Frame Padding="12" CornerRadius="10" BorderColor="Transparent" BackgroundColor="{AppThemeBinding Light=#E3F2FD, Dark=#1A237E}">
                <Label Text="{Binding TotalHoursThisMonth, StringFormat='This month: {0:F1} hours'}" FontSize="16" FontAttributes="Bold" />
            </Frame>

            <!-- Log Form Toggle -->
            <Button Text="Log Overtime"
                    Command="{Binding ToggleLogFormCommand}"
                    BackgroundColor="{StaticResource Primary}" TextColor="White" CornerRadius="12" />

            <VerticalStackLayout Spacing="10" IsVisible="{Binding ShowLogForm}" Padding="0,8">
                <DatePicker Date="{Binding SelectedDate}" />
                <Entry Placeholder="Hours" Text="{Binding Hours}" Keyboard="Numeric" />
                <Entry Placeholder="Notes" Text="{Binding Notes}" />
                <Button Text="Submit" Command="{Binding LogOvertimeCommand}"
                        BackgroundColor="{StaticResource Primary}" TextColor="White" CornerRadius="12" />
            </VerticalStackLayout>

            <!-- Entries List -->
            <CollectionView ItemsSource="{Binding Entries}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeShape="RoundRectangle 10" Stroke="#E0E0E0" Padding="14" Margin="0,0,0,8" BackgroundColor="White">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                <Label Text="{Binding Date, StringFormat='{0:dd MMM}'}" FontSize="14" FontAttributes="Bold" />
                                <Label Grid.Column="1" Text="{Binding Hours, StringFormat='{0:F1}h'}" FontSize="14" />
                                <Label Grid.Column="2" Text="{Binding Status}" FontSize="12" TextColor="Gray" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ui:BaseContentPage>
