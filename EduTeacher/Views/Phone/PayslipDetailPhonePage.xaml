<?xml version="1.0" encoding="utf-8" ?>
<ui:BaseContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ui="clr-namespace:Rootfly.Mobile.Core.UI.Pages;assembly=Rootfly.Mobile.Core.UI"
    xmlns:vm="clr-namespace:EduTeacher.Shared.ViewModels;assembly=EduTeacher.Shared"
    xmlns:dtos="clr-namespace:EduTeacher.Shared.Education.Dtos;assembly=EduTeacher.Shared"
    x:Class="EduTeacher.Views.Phone.PayslipDetailPhonePage"
    x:TypeArguments="vm:PayslipDetailViewModel"
    Title="{Binding Title}">

    <ScrollView Padding="16">
        <VerticalStackLayout Spacing="16">
            <!-- Period header -->
            <Frame Padding="20" CornerRadius="16" BorderColor="Transparent"
                   BackgroundColor="{StaticResource Primary}" HasShadow="True">
                <VerticalStackLayout Spacing="4">
                    <Label Text="{Binding PeriodLabel}" FontSize="18" FontAttributes="Bold" TextColor="White" />
                    <Label Text="{Binding Payslip.NetPay, StringFormat='Net Pay: ₹{0:N0}'}" FontSize="22" FontAttributes="Bold" TextColor="White" />
                </VerticalStackLayout>
            </Frame>

            <!-- Earnings -->
            <Label Text="Earnings" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Secondary}" />
            <CollectionView ItemsSource="{Binding Earnings}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dtos:SalarySlipComponentDto">
                        <Grid ColumnDefinitions="*,Auto" Padding="0,6">
                            <Label Grid.Column="0" Text="{Binding ComponentName}" FontSize="14" />
                            <Label Grid.Column="1" Text="{Binding Amount, StringFormat='₹{0:N0}'}" FontSize="14" FontAttributes="Bold"
                                   TextColor="{StaticResource Secondary}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <BoxView HeightRequest="1" BackgroundColor="{StaticResource Gray200}" />

            <!-- Gross Earnings total -->
            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" Text="Gross Earnings" FontSize="14" FontAttributes="Bold" />
                <Label Grid.Column="1" Text="{Binding Payslip.GrossEarnings, StringFormat='₹{0:N0}'}" FontSize="14" FontAttributes="Bold"
                       TextColor="{StaticResource Secondary}" />
            </Grid>

            <!-- Deductions -->
            <Label Text="Deductions" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Error}" Padding="0,8,0,0" />
            <CollectionView ItemsSource="{Binding Deductions}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dtos:SalarySlipComponentDto">
                        <Grid ColumnDefinitions="*,Auto" Padding="0,6">
                            <Label Grid.Column="0" Text="{Binding ComponentName}" FontSize="14" />
                            <Label Grid.Column="1" Text="{Binding Amount, StringFormat='₹{0:N0}'}" FontSize="14" FontAttributes="Bold"
                                   TextColor="{StaticResource Error}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <BoxView HeightRequest="1" BackgroundColor="{StaticResource Gray200}" />

            <!-- Gross Deductions total -->
            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" Text="Gross Deductions" FontSize="14" FontAttributes="Bold" />
                <Label Grid.Column="1" Text="{Binding Payslip.GrossDeductions, StringFormat='₹{0:N0}'}" FontSize="14" FontAttributes="Bold"
                       TextColor="{StaticResource Error}" />
            </Grid>

            <!-- Net Pay -->
            <Frame Padding="16" CornerRadius="12" BorderColor="Transparent" HasShadow="True" Margin="0,8,0,0"
                   BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="Net Pay" FontSize="16" FontAttributes="Bold" />
                    <Label Grid.Column="1" Text="{Binding Payslip.NetPay, StringFormat='₹{0:N0}'}" FontSize="18" FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />
                </Grid>
            </Frame>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                               HorizontalOptions="Center" Color="{StaticResource Primary}" />
        </VerticalStackLayout>
    </ScrollView>
</ui:BaseContentPage>
