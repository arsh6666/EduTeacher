<?xml version="1.0" encoding="utf-8" ?>
<ui:BaseContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ui="clr-namespace:Rootfly.Mobile.Core.UI.Pages;assembly=Rootfly.Mobile.Core.UI"
    xmlns:vm="clr-namespace:EduTeacher.Shared.ViewModels;assembly=EduTeacher.Shared"
    x:Class="EduTeacher.Views.Phone.SalaryAdvancePhonePage"
    x:TypeArguments="vm:SalaryAdvanceViewModel"
    Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Spacing="12" Padding="16">
            <!-- Header -->
            <Border StrokeShape="RoundRectangle 0,0,24,24" Stroke="Transparent"
                    BackgroundColor="{StaticResource Primary}" Padding="24,48,24,24">
                <Label Text="{Binding Title}" FontSize="24" FontAttributes="Bold" TextColor="White" />
            </Border>

            <!-- Request Form Toggle -->
            <Button Text="Request Advance"
                    Command="{Binding ToggleRequestFormCommand}"
                    BackgroundColor="{StaticResource Primary}" TextColor="White" CornerRadius="12" />

            <VerticalStackLayout Spacing="10" IsVisible="{Binding ShowRequestForm}" Padding="0,8">
                <Entry Placeholder="Amount" Text="{Binding RequestAmount}" Keyboard="Numeric" />
                <Entry Placeholder="Reason" Text="{Binding Reason}" />
                <Stepper Minimum="1" Maximum="24" Value="{Binding RepaymentMonths}" />
                <Label Text="{Binding RepaymentMonths, StringFormat='Repayment: {0} months'}" FontSize="13" />
                <Button Text="Submit Request" Command="{Binding RequestAdvanceCommand}"
                        BackgroundColor="{StaticResource Primary}" TextColor="White" CornerRadius="12" />
            </VerticalStackLayout>

            <!-- Advances List -->
            <CollectionView ItemsSource="{Binding Advances}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeShape="RoundRectangle 10" Stroke="#E0E0E0" Padding="14" Margin="0,0,0,8" BackgroundColor="White">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                <Label Text="{Binding RequestDate, StringFormat='{0:dd MMM yyyy}'}" FontSize="14" FontAttributes="Bold" />
                                <Label Grid.Column="1" Text="{Binding Amount, StringFormat='{0:C}'}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                                <Label Grid.Row="1" Text="{Binding Status}" FontSize="12" TextColor="Gray" />
                                <Label Grid.Row="1" Grid.Column="1" Text="{Binding Reason}" FontSize="12" TextColor="Gray" LineBreakMode="TailTruncation" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ui:BaseContentPage>
