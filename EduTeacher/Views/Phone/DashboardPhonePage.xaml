<?xml version="1.0" encoding="utf-8" ?>
<ui:BaseContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ui="clr-namespace:Rootfly.Mobile.Core.UI.Pages;assembly=Rootfly.Mobile.Core.UI"
    xmlns:vm="clr-namespace:EduTeacher.Shared.ViewModels;assembly=EduTeacher.Shared"
    xmlns:dtos="clr-namespace:EduTeacher.Shared.Education.Dtos;assembly=EduTeacher.Shared"
    x:Class="EduTeacher.Views.Phone.DashboardPhonePage"
    x:TypeArguments="vm:DashboardViewModel"
    Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="16">
            <!-- Welcome header card (blue gradient) -->
            <Frame Padding="20" CornerRadius="16" BorderColor="Transparent"
                   BackgroundColor="{StaticResource Primary}" HasShadow="True">
                <VerticalStackLayout Spacing="4">
                    <Label Text="{Binding WelcomeMessage}" FontSize="20" FontAttributes="Bold" TextColor="White" />
                    <Label Text="{Binding TodayDate}" FontSize="13" TextColor="#CCFFFFFF" />
                </VerticalStackLayout>
            </Frame>

            <!-- Stats row -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                <Frame Grid.Column="0" Padding="12" CornerRadius="12" BorderColor="Transparent" HasShadow="True"
                       BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}">
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Label Text="📅" FontSize="22" HorizontalOptions="Center" />
                        <Label Text="Today's Classes" FontSize="10" TextColor="Gray" HorizontalOptions="Center" />
                        <Label Text="{Binding TodayClassesCount, StringFormat='{0}'}" FontSize="20" FontAttributes="Bold"
                               TextColor="{StaticResource Primary}" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Frame>
                <Frame Grid.Column="1" Padding="12" CornerRadius="12" BorderColor="Transparent" HasShadow="True"
                       BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}">
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Label Text="✅" FontSize="22" HorizontalOptions="Center" />
                        <Label Text="Pending" FontSize="10" TextColor="Gray" HorizontalOptions="Center" />
                        <Label Text="{Binding PendingAttendanceCount, StringFormat='{0}'}" FontSize="20" FontAttributes="Bold"
                               TextColor="{StaticResource Accent}" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Frame>
                <Frame Grid.Column="2" Padding="12" CornerRadius="12" BorderColor="Transparent" HasShadow="True"
                       BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}">
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Label Text="📝" FontSize="22" HorizontalOptions="Center" />
                        <Label Text="To Grade" FontSize="10" TextColor="Gray" HorizontalOptions="Center" />
                        <Label Text="{Binding RecentSubmissionsCount, StringFormat='{0}'}" FontSize="20" FontAttributes="Bold"
                               TextColor="{StaticResource Secondary}" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Frame>
            </Grid>

            <!-- Quick actions -->
            <Label Text="Quick Actions" FontSize="18" FontAttributes="Bold" Padding="0,8,0,0" />
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                <Button Grid.Column="0" Text="Mark Attendance"
                        Command="{Binding NavigateToAttendanceCommand}"
                        BackgroundColor="{StaticResource Secondary}" TextColor="White"
                        CornerRadius="12" HeightRequest="48" FontSize="11" FontAttributes="Bold" />
                <Button Grid.Column="1" Text="Assessments"
                        Command="{Binding NavigateToAssessmentsCommand}"
                        BackgroundColor="{StaticResource Accent}" TextColor="White"
                        CornerRadius="12" HeightRequest="48" FontSize="11" FontAttributes="Bold" />
                <Button Grid.Column="2" Text="Grade"
                        Command="{Binding NavigateToAssessmentsCommand}"
                        BackgroundColor="{StaticResource Primary}" TextColor="White"
                        CornerRadius="12" HeightRequest="48" FontSize="11" FontAttributes="Bold" />
            </Grid>

            <!-- Today's Schedule section -->
            <Label Text="Today's Schedule" FontSize="18" FontAttributes="Bold" Padding="0,8,0,0" />

            <CollectionView ItemsSource="{Binding TodaySchedule}" EmptyView="No classes today">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dtos:TimetableEntryDto">
                        <Frame Padding="14" CornerRadius="12" BorderColor="Transparent" HasShadow="True" Margin="0,0,0,8"
                               BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                    <Label Text="{Binding StartTime, StringFormat='{0:hh\\:mm}'}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                                    <Label Text="{Binding EndTime, StringFormat='{0:hh\\:mm}'}" FontSize="11" TextColor="Gray" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="{Binding CourseName}" FontSize="15" FontAttributes="Bold" />
                                    <Label Text="{Binding SectionName}" FontSize="12" TextColor="Gray" />
                                    <Label Text="{Binding RoomName, StringFormat='Room: {0}'}" FontSize="11" TextColor="Gray" />
                                </VerticalStackLayout>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Loading -->
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                               HorizontalOptions="Center" Color="{StaticResource Primary}" />

            <!-- Logout -->
            <Button Text="Logout" Command="{Binding LogoutCommand}" Margin="0,16,0,0"
                    BackgroundColor="Transparent" TextColor="{StaticResource Error}"
                    HorizontalOptions="Center" />
        </VerticalStackLayout>
    </ScrollView>

</ui:BaseContentPage>
