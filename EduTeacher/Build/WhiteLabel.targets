<Project>
  <PropertyGroup>
    <ClientProfile Condition="'$(ClientProfile)' == ''">default</ClientProfile>
    <ClientDir>$(MSBuildProjectDirectory)/../Clients/$(ClientProfile)</ClientDir>
  </PropertyGroup>

  <!--
    Import per-client MSBuild props (icon/splash background colors).
    Each client folder may contain a client.props file like:
      <Project>
        <PropertyGroup>
          <ClientAppIconColor>#1A2B3C</ClientAppIconColor>
          <ClientSplashColor>#1A2B3C</ClientSplashColor>
        </PropertyGroup>
      </Project>
  -->
  <Import Project="$(ClientDir)/client.props" Condition="Exists('$(ClientDir)/client.props')" />

  <!-- Fallback colors when client.props does not set them -->
  <PropertyGroup>
    <ClientAppIconColor Condition="'$(ClientAppIconColor)' == ''">#1A73E8</ClientAppIconColor>
    <ClientSplashColor  Condition="'$(ClientSplashColor)'  == ''">#1A73E8</ClientSplashColor>
  </PropertyGroup>

  <!--
    App Icon override.
    Place appicon.svg (and optionally appiconfg.svg) in Clients/{profile}/
    to replace the default icon at build time.
  -->
  <ItemGroup Condition="Exists('$(ClientDir)/appicon.svg')">
    <MauiIcon Remove="Resources\AppIcon\appicon.svg" />
    <MauiIcon Include="$(ClientDir)/appicon.svg"
              ForegroundFile="$(ClientDir)/appiconfg.svg"
              Condition="Exists('$(ClientDir)/appiconfg.svg')"
              Color="$(ClientAppIconColor)" />
    <MauiIcon Include="$(ClientDir)/appicon.svg"
              Condition="!Exists('$(ClientDir)/appiconfg.svg')"
              Color="$(ClientAppIconColor)" />
  </ItemGroup>

  <!--
    Splash Screen override.
    Place splash.svg in Clients/{profile}/ to replace the default splash.
  -->
  <ItemGroup Condition="Exists('$(ClientDir)/splash.svg')">
    <MauiSplashScreen Remove="Resources\Splash\splash.svg" />
    <MauiSplashScreen Include="$(ClientDir)/splash.svg"
                      Color="$(ClientSplashColor)"
                      BaseSize="128,128" />
  </ItemGroup>

  <!-- Copy runtime assets (json configs, raw assets, fonts) to Resources/Raw -->
  <Target Name="CopyClientAssets" BeforeTargets="Build">
    <ItemGroup>
      <ClientFiles Include="$(ClientDir)/client.json" />
      <ClientFiles Include="$(ClientDir)/colors.json" />
      <ClientFiles Include="$(ClientDir)/assets/**/*" Exclude="$(ClientDir)/assets/**/.gitkeep" />
      <ClientFiles Include="$(ClientDir)/fonts/**/*"  Exclude="$(ClientDir)/fonts/**/.gitkeep" />
    </ItemGroup>
    <Copy SourceFiles="@(ClientFiles)"
          DestinationFolder="$(MSBuildProjectDirectory)/Resources/Raw/%(RecursiveDir)"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
